+_WEB_IDENTITY_STOPWORDS: frozenset[str] = frozenset(
+    {"the", "and", "for", "what", "how", "why", "which", "with", "from", "that",
+     "this", "are", "was", "does", "can", "you", "not", "http", "https", "www"}
