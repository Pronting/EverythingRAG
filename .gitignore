# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# ---- Node / 前端 ----
node_modules/
frontend/dist/
*.tsbuildinfo

# ---- 运行时数据（本地知识库/向量库，绝不上传） ----
data/
# 例外：V1.2.0 路由评测集是**交付物**（PRD 16.3 要求 ≥120 题数据集），
# 不能被上面那条宽泛的 `data/` 规则静默排除在提交之外。
!backend/tests/data/
!backend/tests/data/**
.everything-rag/
*.gguf
models/
!backend/app/models/
!backend/app/models/*.py

# ---- 施工/内部开发过程（不进公开仓库）----
.claude/
.spec-workflow/
docs/loop/
docs/superpowers/
# AgentTeams 运行时状态（任务台账/邮箱/计划，~1MB；不是交付物）
.agent-teams/
# 临时测试输出（成员调试时落在仓库根的 pytest 输出）
baseline_pytest*.txt

# ---- 敏感信息（环境变量/凭据/密钥，禁止入库）----
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
*.key
!*.pub
*secret*
*credential*
credentials.json
config.local.*

# ---- 个人/工具 ----
.playwright-mcp/
.playwright/
.tmp_probe/

# ---- benchmark 数据产物（PRD §7.2 / T22）----
# 这些 JSON 是对私人语料跑出来的实验产物，逐字含真实分块正文、来源文件名、标题、
# 人名与可识别时间戳，只在本机生成与保存（默认落在 benchmark/，也见
# .tmp_probe/rag-relevance/benchmark-private/）。仓库只留生成脚本、聚合结果与
# 脱敏后的用例结构；详见 benchmark/BENCHMARK_REPORT.md 与 benchmark/cases_loader.py。
benchmark/*.json
!benchmark/cases.json
!benchmark/aggregate.json
!benchmark/aggregate_optimized.json
!benchmark/answer_aggregate.json

# ---- IDE / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
