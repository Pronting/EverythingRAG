# ============================================================================
# Everything RAG — 环境变量配置模板（MVP）
# ============================================================================
# 用法：
#   1. 复制本文件为 backend/.env（.env 已在 .gitignore 中，绝不入库）：
#        git-bash:   cp .env.example .env
#        PowerShell: Copy-Item .env.example .env
#   2. 按下文说明填入你的配置
#   3. 重启服务生效： backend/.venv/Scripts/python scripts/run.py
#
# 读取逻辑：backend/app/core/config.py（pydantic-settings）
#   - 优先级：真实环境变量 > .env 文件 > 代码默认值
#   - 前缀：所有变量必须以 EVERYTHING_RAG_ 开头才会被读取
#   - 位置：.env 必须放在 backend/ 目录（run.py 以 backend 为工作目录启动 uvicorn）
#   - 隐私：API key 只在运行期从环境读取，绝不写入 config/日志
#
# 所有已注释的项 = 有默认值、可留空；需要修改时取消注释即可。
# ============================================================================


# ----------------------------------------------------------------------------
# ① 对话模型（必配）—— 问答生成的模型
#    支持云端 / 本地，本模板按「云端 OpenAI 兼容」填写
# ----------------------------------------------------------------------------

# Provider 类型（默认 openai_compatible，一般无需改）
#EVERYTHING_RAG_CHAT_PROVIDER_TYPE=openai_compatible

# Base URL —— OpenAI 兼容端点地址（必填）
#   云端厂商示例：
#     OpenAI：        https://api.openai.com/v1
#     DeepSeek：      https://api.deepseek.com/v1
#     Kimi/Moonshot： https://api.moonshot.cn/v1
#     SiliconFlow：   https://api.siliconflow.cn/v1
#   也支持自建网关/代理（填对应 OpenAI 兼容端点）
#EVERYTHING_RAG_CHAT_BASE_URL=https://api.example.com/v1

# 模型名（必填）—— 云端填 API model id，例如：
#   gpt-4o-mini / gpt-4o / deepseek-chat / moonshot-v1-8k
#EVERYTHING_RAG_CHAT_MODEL=gpt-4o-mini

# API Key（云端必填；本地 Ollama 无需填）
#   只填 Key 本身，不要带 "Bearer " 前缀，程序会自动加上
#   Key 仅运行期读取 + 出网审计只记域名，绝不落盘/打日志
#EVERYTHING_RAG_CHAT_API_KEY=sk-xxxxxxxxxxxxxxxx

# （可选）自定义 Key 所在的环境变量名。默认就是上面的
#   EVERYTHING_RAG_CHAT_API_KEY；仅在你想把 Key 换到别的变量名时修改。
#EVERYTHING_RAG_CHAT_API_KEY_ENV=EVERYTHING_RAG_CHAT_API_KEY


# ----------------------------------------------------------------------------
# ② 嵌入模型（必配）—— 云端 OpenAI 兼容 /embeddings
#    本地 fastembed/bge-m3 已移除；嵌入统一走云端（快、省心、无本地下载）。
#    切换嵌入模型 = 新向量空间 = 需重新导入全部文档。
# ----------------------------------------------------------------------------

# Base URL —— OpenAI 兼容嵌入端点（必填）
#   主流 OpenAI 兼容平台均支持，例如：
#     硅基流动： https://api.siliconflow.cn/v1
#     其他：     任何支持 POST /v1/embeddings 的端点
#EVERYTHING_RAG_EMBED_BASE_URL=https://api.siliconflow.cn/v1

# 模型名（必填）—— 云端文本嵌入模型 id，例如：
#   BAAI/bge-m3 / Qwen/Qwen3-Embedding-8B
#EVERYTHING_RAG_EMBED_MODEL=Qwen/Qwen3-Embedding-8B

# API Key（云端必填；只填 Key 本身，不带 "Bearer " 前缀）
#   隐私红线：仅运行期读取 + 出网审计只记域名，绝不落 config/日志；
#   .env 已在 .gitignore 中，绝不上传 Git。
#EVERYTHING_RAG_EMBED_API_KEY=sk-xxxxxxxxxxxxxxxx


# ----------------------------------------------------------------------------
# ③ 识图模型（v0.1 未实现，先留位）
# ----------------------------------------------------------------------------
# 识图功能开关（默认关；v0.1 实现前保持关闭）
#EVERYTHING_RAG_VISION_ENABLED=false


# ----------------------------------------------------------------------------
# ④ 联网搜索（可选）—— 问答时检索网络（Tavily）
#    默认关闭；开启并配好 Key 后，输入框的「联网搜索」按钮才可用。
#    出网需显式 opt-in：即使启用，也要在每次发送时手动点亮该按钮。
#    注：联网搜索会把你的问题原文发送给搜索服务商（Tavily）。
# ----------------------------------------------------------------------------

# 是否启用联网搜索能力（默认 false）
#EVERYTHING_RAG_SEARCH_ENABLED=false

# 搜索 provider（默认 tavily；SearXNG 自托管为后续可插拔实现）
#EVERYTHING_RAG_SEARCH_PROVIDER_TYPE=tavily

# Tavily API Key（provider=tavily 且启用时必填；只填 Key 本身）
#EVERYTHING_RAG_SEARCH_API_KEY=tvly-xxxxxxxxxxxxxxxx

# SearXNG 实例地址（provider=searxng 时填；Tavily 留空用官方端点）
#EVERYTHING_RAG_SEARCH_BASE_URL=

# 每次搜索返回的结果条数（默认 5，范围 1–10）
#EVERYTHING_RAG_SEARCH_MAX_RESULTS=5


# ----------------------------------------------------------------------------
# ⑤ 本地数据 / 服务
# ----------------------------------------------------------------------------
# 数据目录：向量库 / state.db / 配置，均不出本机（默认 ~/.everything-rag）
#EVERYTHING_RAG_DATA_DIR=
# 绑定地址与端口（默认 127.0.0.1:9999；run.py 固定使用 9999）
#EVERYTHING_RAG_HOST=127.0.0.1
#EVERYTHING_RAG_PORT=9999
# CORS：同源部署默认关闭；仅当用独立前端 dev server 调试时才打开
#EVERYTHING_RAG_ENABLE_CORS=false
#EVERYTHING_RAG_CORS_ORIGINS=["http://localhost:5173"]


# ----------------------------------------------------------------------------
# ⑥ 配置向导状态（v0.1 实现；当前仅后端预留位，手动置 true 不产生副作用）
# ----------------------------------------------------------------------------
#EVERYTHING_RAG_WIZARD_COMPLETED=false

# 导入并发（1–16，默认 4；服务商限流时降低为 1 或 2，重启生效）
#EVERYTHING_RAG_INGEST_EMBED_WORKERS=4
#EVERYTHING_RAG_INGEST_PARSE_WORKERS=4
